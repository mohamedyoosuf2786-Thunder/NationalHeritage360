  213:   }, [submissions]);
  214  
  215:   // Dynamic Level Calculation
  216:   const calculateLevel = (xp: number) => {
  217      if (xp < 250) {
  218:       return { name: 'Heritage Shishya', level: 1, nextLevelXP: 250, title: 'Inquisitive Seeker of Lore' };
  219      } else if (xp < 600) {
  220:       return { name: 'Dharohar Explorer', level: 2, nextLevelXP: 600, title: 'Voyager of Sacred Geometries' };
  221      } else if (xp < 1200) {
  222:       return { name: 'Parampara Guardian', level: 3, nextLevelXP: 1200, title: 'Preserver of Living Traditions' };
  223      } else {
  224:       return { name: 'Virasat Acharya', level: 4, nextLevelXP: 2500, title: 'Master Ambassador of Indian Heritage' };
  225      }

  227  
  228:   const userLevel = calculateLevel(userXP);
  229  
