  450:         title: 'Kutch Nomadic Mirror Embroidery',
  451:         desc: 'Over 16 distinct sub-styles (Rabari, Mutwa, Ahir, Jat) combining mirrors (Abhla) and intricate needlework that identify a woman’s marital and tribal lineage.',
  452:         significance: 'Visual community language and pastoral heritage.',
  453          tags: ['Textile Heritage', 'Nomadic Crafts']

  457        {
  458:         name: 'Rann Utsav (White Desert Festival)',
  459:         season: 'November to February',
  460:         desc: 'Cultural carnival on the white salt flats of Kutch celebrating desert stargazing, Sufi songs, and camel safaris.',
  461:         rituals: 'Full moon midnight musical concerts on the salt desert expanse.'
  462        },
  463        {
  464:         name: 'Uttarayan (International Kite Festival)',
  465:         season: 'January 14 (Makar Sankranti)',
  466:         desc: 'Sky-filling festival where millions fly rooftop kites shouting "Kai Po Che!" marking the sun’s northern journey.',
  467:         rituals: 'Consuming sesame brittle (Chikki) and baked winter vegetable dish Undhiyu.'
  468        }

  471        {
