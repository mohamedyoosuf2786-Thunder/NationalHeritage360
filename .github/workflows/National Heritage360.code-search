Heritage360\src\data\timelineErasData.ts:
    6      name: 'Ancient Era',
    7:     subTitle: 'The Dawn of Urbanism, Vedas & Monolithic Art',
    8      yearRange: '3300 BCE – 600 CE',
    9:     overview: 'From the meticulously planned brick cities and subterranean drainage of the Indus Valley to the golden age of Gupta mathematics, literature, and the rock-cut cave sanctuaries of Ajanta and Ellora.',
   10:     culturalPillars: [
   11        {
   12:         title: 'Harappan Urban Planning & Metrology',
   13:         description: 'Standardized baked brick ratios (1:2:4), multi-story residences, and the Great Bath of Mohenjo-daro exhibiting early bitumen waterproofing technology.',
   14:         verifiedSource: 'Archaeological Survey of India (ASI) Indus Civilization Excavation Reports'
   15        },
   16        {
   17:         title: 'Vedic Oral Chanting (UNESCO World Heritage)',
   18:         description: 'The world’s oldest continuously preserved oral recitation system, codified with exact pitch accents (Udatta, Anudatta, Svarita) that preserved texts without drift for millennia.',
   19:         verifiedSource: 'UNESCO Representative List of the Intangible Cultural Heritage of Humanity'
   20        },
   21        {
   22:         title: 'Mauryan Polished Stone Edicts & Ashoka Pillar',
   23:         description: 'Mirror-like lustrous Chunar sandstone pillars inscribed in Brahmi script, declaring universal ethical tenets (Dhamma), non-violence, and ecological preservation.',
   24:         verifiedSource: 'National Museum New Delhi & Epigraphia Indica'
   25        }

   28        name: 'The Dancing Girl of Mohenjo-daro',
   29:       period: 'c. 2300–1750 BCE (Mature Harappan)',
   30        material: 'Lost-wax cast Bronze alloy',
   31:       locationFound: 'HR Area, Mohenjo-daro (Indus Valley)',
   32:       currentPreservation: 'National Museum, New Delhi (Gallery of Harappan Art)',
   33:       description: 'A 10.5-centimeter bronze statuette depicting a poised young woman standing in a confident tribhanga stance. Her arm is stacked with bangles made of conch shell, manifesting ancient metallurgical and lost-wax casting mastery.',
   34        modelType: 'dancing_girl',

   36          { x: -0.1, y: 0.8, label: 'Shell Bangles', fact: 'Over 24 bangles adorn her left arm, indicating advanced maritime shell trading across the Arabian Sea.' },
   37:         { x: 0.0, y: 0.4, label: 'Tribhanga Posture', fact: 'The relaxed three-bend posture anticipates later Indian classical dance stances by two thousand years.' },
   38:         { x: 0.1, y: 1.1, label: 'Chignon Hairdo', fact: 'Intricately coiled hair tied back in a heavy bun reflecting refined Harappan grooming aesthetics.' }
   39        ]

   41      achievements: [
   42:       'Invention of Decimal System and Zero (Aryabhata & Brahmagupta)',
   43:       'Ayurveda treatises of Charaka and Sushruta (Cataract & Rhinoplasty)',
   44:       'Rock-cut monolithic architecture (Barabar Caves, Ajanta)'
   45      ]

   49      name: 'Medieval Era',
   50:     subTitle: 'The Age of Grand Temples, Lost-Wax Bronzes & Indo-Islamic Syntheses',
   51      yearRange: '600 CE – 1750 CE',
   52:     overview: 'An epoch of extraordinary architectural and aesthetic synthesis: soaring granite gopurams of the Cholas, Vijayanagara stone chariots, delicate sandstone jali lattices, and the blossoming of miniature painting traditions.',
   53:     culturalPillars: [
   54        {
   55:         title: 'Chola Lost-Wax Bronze Sculpture',
   56:         description: 'The pinnacle of sacred metallurgical art under Raja Raja Chola I and Queen Sembiyan Mahadevi, creating fluid deities according to Agamic proportions.',
   57:         verifiedSource: 'Government Museum Chennai & UNESCO Great Living Chola Temples'
   58        },
   59        {
   60:         title: 'Vijayanagara Monolithic Architecture',
   61:         description: 'The monumental world city of Hampi featuring musical pillars that ring with distinct acoustic pitches when struck, water aqueducts, and the Stone Chariot.',
   62:         verifiedSource: 'UNESCO World Heritage Group of Monuments at Hampi'
   63        },
   64        {
   65:         title: 'Mughal & Rajput Miniature Painting',
   66:         description: 'Intricate illuminated manuscripts crafted with squirrel-hair brushes, utilizing lapis lazuli, crushed pearls, and malachite pigments.',
   67:         verifiedSource: 'Victoria and Albert Museum & National Museum New Delhi'
   68        }

   71        name: 'Nataraja: The Cosmic Dancer',
   72:       period: 'c. 10th–11th Century CE (Chola Dynasty)',
   73        material: 'Panchaloha (Sacred five-metal lost-wax bronze alloy)',
   74:       locationFound: 'Thanjavur, Tamil Nadu',
   75:       currentPreservation: 'Thanjavur Art Gallery & National Museum',
   76:       description: 'The supreme iconographic synthesis of science, philosophy, and art: Shiva dances within an arch of fire (Prabha Mandala), holding the drum of cosmic creation in his upper right hand and the flame of transformation in his left.',
   77        modelType: 'nataraja',
   78        hotspots: [
   79:         { x: 0.35, y: 0.9, label: 'Damaru (Creation)', fact: 'The hourglass drum vibrates with the primordial sound (Nada Brahma), initiating space and time.' },
   80:         { x: -0.35, y: 0.9, label: 'Agni (Transformation)', fact: 'The eternal flame dissolves illusions and purifies the cosmic cycle.' },
   81:         { x: 0.0, y: -0.4, label: 'Apasmara Dwarf', fact: 'The demon of ignorance and forgetfulness trampled beneath the sacred foot of wisdom.' }
   82        ]

   84      achievements: [
   85:       'Acoustic Musical Stone Pillars at Hampi and Madurai',
   86:       'Pietra Dura and Perforated Sandstone Jali Lattice screens',
   87:       'Development of Classical Hindustani and Carnatic Raga systems'
   88      ]

   92      name: 'Colonial Era',
   93:     subTitle: 'Swadeshi Resistance, Handloom Revival & Renaissance',
   94      yearRange: '1750 CE – 1947 CE',
   95:     overview: 'As mechanized textile mills of industrial Britain threatened centuries-old Indian handlooms, the spinning wheel (Charkha) and indigenous crafts transformed into weapons of non-violent political resistance and cultural revival.',
   96:     culturalPillars: [
   97        {
   98          title: 'The Swadeshi Handloom Movement',
   99:         description: 'Mahatma Gandhi transformed handspun Khadi cloth into the uniform of the freedom struggle, restoring dignity and economic self-sufficiency to village artisans.',
  100:         verifiedSource: 'National Gandhi Museum & Sabarmati Ashram Archives'
  101        },

  103          title: 'The Bengal Renaissance',
  104:         description: 'Intellectual and aesthetic revival spearheaded by Rabindranath Tagore, Abanindranath Tagore, and Raja Ravi Varma, blending Asian visual idioms with modern humanist philosophy.',
  105:         verifiedSource: 'Visva-Bharati University, Santiniketan & Sahitya Akademi'
  106        },
  107        {
  108:         title: 'Classical Dance & Music Institutionalization',
  109:         description: 'Revival of traditional Sadir into modern Bharatanatyam (Rukmini Devi Arundale at Kalakshetra) and Kathakali at Kerala Kalamandalam by Vallathol Narayana Menon.',
  110:         verifiedSource: 'Sangeet Natak Akademi National Archives'
  111        }

  116        material: 'Indian Teak wood, Cotton drive-cord, Steel spindle',
  117:       locationFound: 'Wardha & Sabarmati, Gujarat',
  118:       currentPreservation: 'Mani Bhavan & Sabarmati Ashram',
  119:       description: 'Invented by Mahatma Gandhi while imprisoned in Yerwada jail, the portable folding box Charkha symbolized self-reliance, unity of all citizens, and resistance against colonial economic dominance.',
  120        modelType: 'charkha',
  121        hotspots: [
  122:         { x: -0.2, y: 0.4, label: 'Spindle Mechanism', fact: 'Spins uncarded cotton into fine threads with an energy-efficient hand-cranked gear ratio.' },
  123:         { x: 0.25, y: 0.2, label: 'Compact Box Design', fact: 'Folds neatly into a briefcase so freedom volunteers could carry their production wherever they travelled.' },
  124:         { x: 0.0, y: -0.1, label: 'Philosophy of Labor', fact: 'Every citizen spinning 30 minutes daily leveled all socioeconomic distinctions.' }
  125        ]

  128        'Creation of the Indian National Flag centered on the Ashoka Chakra',
  129:       'Foundation of Santiniketan as an open-air world university',
  130        'Codification of classical ragas into standardized Thaat systems'

  135      name: 'Modern Era',
  136:     subTitle: 'Constitutional Safeguards, GI Protections & Global Accolades',
  137      yearRange: '1947 CE – Present',
  138:     overview: 'Independent India established national cultural institutions, enacted the Geographical Indications of Goods Act to protect generational crafts, and inscribed 42 UNESCO World Heritage properties.',
  139:     culturalPillars: [
  140        {
  141          title: 'Geographical Indications (GI) Registry',
  142:         description: 'Over 500 indigenous crafts, textiles, and agricultural cultivars granted legal protection against duplication, preserving artisan guilds.',
  143:         verifiedSource: 'Intellectual Property India (GI Registry Office, Chennai)'
  144        },
  145        {
  146:         title: 'National Cultural Academies',
  147:         description: 'Formation of Lalit Kala, Sangeet Natak, and Sahitya Akademies to preserve oral dialects, folk instruments, and living legends.',
  148:         verifiedSource: 'Ministry of Culture, Government of India'
  149        },
  150        {
  151:         title: 'Tribal Cultural Preservation Initiatives',
  152:         description: 'Documentation of Dhokra metal casting, Warli and Gond tribal art, and the preservation of sacred forest groves (Devarakadus).',
  153:         verifiedSource: 'TRIFED (Tribal Cooperative Marketing Development Federation of India)'
  154        }

  157        name: 'The Ashoka Lion Capital (National Emblem)',
  158:       period: 'Adopted January 26, 1950 (Origin 250 BCE Sarnath)',
  159        material: 'Carved Sandstone & Modern Bronze Cast',
  160:       locationFound: 'Sarnath, Uttar Pradesh',
  161:       currentPreservation: 'Rashtrapati Bhavan & Sarnath Archaeological Museum',
  162:       description: 'The formal emblem of the Republic of India: Four Asiatic lions standing back to back symbolizing power, courage, pride, and confidence, mounted on a circular abacus with the 24-spoke Dharma Chakra.',
  163        modelType: 'satellite',
  164        hotspots: [
  165:         { x: 0.0, y: 0.8, label: 'Four Lions', fact: 'Radiating moral guardianship in all four cardinal directions.' },
  166:         { x: 0.0, y: 0.1, label: '24-Spoke Wheel', fact: 'The Chakra of eternal righteousness and continuous national progress.' },
  167:         { x: 0.0, y: -0.4, label: 'Satyameva Jayate', fact: '"Truth Alone Triumphs", an ancient aphorism from the Mundaka Upanishad.' }
  168        ]

  170      achievements: [
  171:       '42 UNESCO World Heritage Sites (including Santiniketan and Hoysala Sacred Ensembles in 2023)',
  172:       '15 UNESCO Intangible Cultural Heritage Inscriptions',
  173:       'The National Mission for Manuscripts digitizing 5 million ancient texts'
  174      ]

  176    {
  177:     id: 'future',
  178:     name: 'Future Horizon',
  179:     subTitle: 'AI Preservation, 3D Digital Twins & Living Metaspheres',
  180      yearRange: '2026 and Beyond',
  181:     overview: 'Empowering future generations with spatial computing, generative AI that revives lost dialects, millimeter-accurate LiDAR scans of monolithic temples, and immutable provenance for rural weavers.',
  182:     culturalPillars: [
  183        {
  184:         title: 'Millimeter-Accurate LiDAR Digital Twins',
  185:         description: 'Terrestrial laser scanners and drone photogrammetry capturing sacred rock architecture down to the millimeter to protect against climate erosion.',
  186:         verifiedSource: 'Smart India Hackathon 2026 Research Initiative & ASI Digital Heritage Project'
  187        },
  188        {
  189:         title: 'AI Dialect Guardians',
  190:         description: 'Neural speech synthesis models trained with tribal elders to prevent the extinction of endangered oral languages that have no written script.',
  191:         verifiedSource: 'National Language Translation Mission (Bhashini, MeitY)'
  192        },

  194          title: 'Artisan Provenance On the Decentralized Web',
  195:         description: 'Smart cryptographically verifiable tags woven directly into silk borders, guaranteeing genuine artisan compensation and fair trade.',
  196:         verifiedSource: 'Ministry of Textiles & Handloom Export Promotion Council'
  197        }

  201        period: '2026 – Present (Smart India Hackathon)',
