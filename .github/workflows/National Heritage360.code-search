  284:         gain.gain.linearRampToValueAtTime(0.18, now + idx * 0.12 + 0.03);
  285:         gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.12 + 1.2);
  286  

  297  
  298:   const addXP = (amount: number, reason: string) => {
  299:     setUserXP(prev => {
  300:       const next = prev + amount;
  301:       return next;
  302      });
  303:     playSuccessChime();
  304      setNotification({
  305:       message: `+${amount} XP Earned! ${reason}`,
  306        type: 'xp'

  309  
  310:   const unlockBadge = (badgeId: string) => {
  311      setBadges(prev => {
  312        const target = prev.find(b => b.id === badgeId);
  313:       if (target && !target.unlocked) {
  314:         playSuccessChime();
  315          setNotification({
  316:           message: `Badge Unlocked: "${target.name}"!`,
  317            type: 'badge'
  318          });
  319:         return prev.map(b => b.id === badgeId ? { ...b, unlocked: true, unlockedAt: new Date().toISOString().split('T')[0] } : b);
  320        }
  321:       return prev;
  322      });

  334      if (creation.type === 'kolam') {
  335:       unlockBadge('kolam-master');
  336      } else if (creation.type === 'pottery') {
  337:       unlockBadge('potter-apprentice');
  338      }

