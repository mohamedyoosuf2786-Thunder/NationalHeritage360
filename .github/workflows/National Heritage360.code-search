  203:       locationFound: 'Distributed Cloud Node',
  204:       currentPreservation: 'Living National Digital Cultural Archive',
  205:       description: 'An interactive 3D digital sphere unifying sacred geometry, folk art traditions, and continuous citizen crowdsourcing into an eternal living cultural repository.',
  206        modelType: 'digital_mandala',
  207        hotspots: [
  208:         { x: 0.0, y: 0.6, label: 'Neural Mesh', fact: 'Synthesizes archival photography with laser scans to reconstruct damaged stone murals.' },
  209:         { x: -0.3, y: 0.0, label: 'Living Voice Stream', fact: 'Speaks 22 official Indian languages with indigenous regional inflections.' },
  210:         { x: 0.3, y: -0.3, label: 'Community Crowdsourcing', fact: 'Directly linked to grassroots student contributions across every district in India.' }
  211        ]

