  21:         <div className="p-2.5 rounded-xl bg-amber-500/20 text-amber-400 flex-shrink-0 mt-0.5">
  22            {notification.type === 'xp' ? (

  31          <div className="flex-1 pr-4">
  32:           <div className="text-xs uppercase tracking-wider text-amber-400 font-bold mb-0.5">
  33:             {notification.type === 'xp' ? 'Dharohar Milestone' : notification.type === 'badge' ? 'Honor Unlocked' : 'Success'}
  34            </div>
  35:           <p className="text-sm font-medium text-stone-100 leading-snug">
  36              {notification.message}

  39  
  40:         <button 
  41            onClick={dismissNotification}

  45            <X className="w-4 h-4" />
  46:         </button>
  47        </div>

