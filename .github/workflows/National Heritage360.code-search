  432      greeting: 'નમસ્તે (Namaste / Jai Shri Krishna)',
  433:     languageSpoken: 'Gujarati, Kutchi',
  434:     audioGreetingText: 'Namaste! Welcome to Gujarat, the land of the Great Rann salt desert, exquisite Patola double-ikats, and the 9-night celebration of Garba.',
  435:     summary: 'A maritime merchant state with a 4,500-year trade legacy rooted in the Indus Valley port of Lothal, renowned for nomadic embroidery, stepwells, and vibrant Garba dances.',
  436:     bannerImage: 'https://images.unsplash.com/photo-1570789210967-2cac24afeb00?auto=format&fit=crop&w=1200&q=80',
  437:     verifiedSource: {
  438:       institution: 'Archaeological Survey of India & UNESCO Intangible Cultural Heritage',
  439:       referenceDoc: 'UNESCO Inscription #01962 (Garba of Gujarat) & Dholavira World Heritage #1642',
  440        verifiedYear: 2023

  444          title: 'Garba & Dandiya Raas',
  445:         desc: 'UNESCO Inscribed Intangible Cultural Heritage: World’s largest nine-night dance festival celebrating divine feminine Shakti around an earthen lantern (Garbhadip).',
  446:         significance: 'Community cohesion, women’s empowerment, and cyclical cosmic time.',
  447:         tags: ['UNESCO Intangible', 'Folk Dance', 'Sacred Feminine']
  448        },
