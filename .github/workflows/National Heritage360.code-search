  495:         culturalRoots: 'Traditional earthenware earthen oven cooking practiced by farmers during harvest.'
  496        },

  499          giTagged: false,
  500:         desc: 'Light steamed fermented chickpea and rice cakes seasoned with mustard seeds, curry leaves, and green chillies.',
  501:         culturalRoots: 'Ancient Jain and Vaishnava culinary principles of gentle steam cooking.'
