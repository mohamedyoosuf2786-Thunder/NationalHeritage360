  369          playChime();
  370:         return { ...item, likes: item.likes + 1 };
  371        }
  372:       return item;
  373      }));

  375  
  376:   const toggleSound = () => {
  377:     setSoundEnabled(prev => !prev);
  378    };

  380    const dismissNotification = () => {
  381:     setNotification(null);
  382    };
  383  
  384:   return (
  385      <HeritageContext.Provider
